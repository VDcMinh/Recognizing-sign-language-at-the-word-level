# ============================================================
# Raw dataset policy
# Keep raw metadata/docs visible to git if needed.
# Never commit raw videos.
# ============================================================
data/datasets/WLASL/raw/videos/**
!data/datasets/WLASL/raw/videos/.gitkeep


# ============================================================
# Generated dataset layers
# These are generated by preprocessing/pipeline stages.
# ============================================================
data/datasets/WLASL/standardized/
data/datasets/WLASL/pose/
data/datasets/WLASL/branch_inputs/
data/datasets/WLASL/audits/


# ============================================================
# Model checkpoints and downloaded model assets
# ============================================================
checkpoints/**/*.pth
checkpoints/**/*.pt
checkpoints/**/*.ckpt

# Downloaded RTMW-l / MMPose assets
checkpoints/pose/rtmw_l/*
!checkpoints/pose/rtmw_l/.gitkeep
!checkpoints/pose/rtmw_l/README.md


# ============================================================
# Local smoke-test outputs
# ============================================================
scripts/tools/_rtmw_mmpose_video_test_output/
scripts/tools/_*_test_output/


# ============================================================
# Experiment outputs
# ============================================================
experiments/**/runs/
experiments/**/outputs/
experiments/**/wandb/


# ============================================================
# Generated reports / figures
# ============================================================
reports/figures/generated/


# ============================================================
# Kaggle packaging outputs
# ============================================================
kaggle_bundle/
*.zip


# ============================================================
# OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo





# Generated data: WLASL index layer
data/datasets/WLASL/index/**/*.csv
data/datasets/WLASL/index/**/*.json
data/datasets/WLASL/index/**/*.txt
data/datasets/WLASL/index/**/*.md
